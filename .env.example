# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (add https://smittywerbenn.github.io for the GitHub Pages frontend)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://smittywerbenn.github.io

# Single-user login password (required for any public deployment; empty = no login).
# Changing it logs out every session.
APP_PASSWORD=
AUTH_TOKEN_TTL_HOURS=168

# ─── Storage ───────────────────────────────────────────────
POSTGRES_USER=cryptoinsight
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cryptoinsight
DATABASE_URL=postgres://cryptoinsight:change-me@localhost:5432/cryptoinsight
REDIS_URL=redis://localhost:6379

# ─── Binance (public market data, no API key needed) ───────
BINANCE_API_URL=https://api.binance.com
# Official public market-data mirror, used automatically on network errors
BINANCE_API_FALLBACK_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_WS_FALLBACK_URL=wss://data-stream.binance.vision
BINANCE_FUTURES_API_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# ─── AI provider (backend only — never exposed to the frontend) ─
# anthropic = Claude (ANTHROPIC_*). openai-compatible = any OpenAI-compatible API (AI_COMPAT_*),
# e.g. Google Gemini (free tier, key from https://aistudio.google.com/apikey), Groq or OpenRouter.
AI_PROVIDER=anthropic
AI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=gemini-3.1-flash-lite
# json_schema (strict structured output) | json_object (for providers without json_schema support)
AI_COMPAT_JSON_MODE=json_schema
# Optional, e.g. low | medium | high (leave empty if the provider rejects it)
AI_COMPAT_REASONING_EFFORT=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallbacks (Opus 5 / Fable 5 family)
ANTHROPIC_ENABLE_FALLBACKS=true
# Language of AI prose: id (Bahasa Indonesia) | en
AI_LANGUAGE=id
AI_CACHE_TTL_SECONDS=1800
AI_MARKET_SUMMARY_MINUTES=60

# ─── Optional providers ────────────────────────────────────
COINGECKO_API_URL=https://api.coingecko.com/api/v3
FEAR_GREED_API_URL=https://api.alternative.me/fng/
CRYPTOPANIC_API_KEY=

# ─── Jobs & analysis ───────────────────────────────────────
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT
ANALYSIS_TIMEFRAME=4h
AI_ANALYSIS_CRON=*/15 * * * *
SIGNAL_TRACKER_CRON=*/5 * * * *
ENABLE_JOBS=true
ENABLE_WEBSOCKET=true
# Suppress counter-trend signals: SELL/STRONG_SELL in a BULL regime (price & MA50 above MA200)
# and BUY/STRONG_BUY in a BEAR regime become HOLD with no trade levels. true = recommended.
ENABLE_REGIME_FILTER=true
RATE_LIMIT_MAX=300
MIN_RELIABLE_SAMPLE=30
FULL_METRICS_SAMPLE=100

# ─── Paper Trading V2 (hourly scan + 5-minute exit monitor, 3 × Rp10.000.000 virtual) ─────────
ENABLE_PAPER_JOB=true

# true = synthetic data for offline development. NEVER mixed with real data.
MOCK_MODE=false
